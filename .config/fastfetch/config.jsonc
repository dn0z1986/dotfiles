{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "gentoo_small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "magenta",
      "2": "white"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta"
    },
    "key": {
      "width": 4
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "󰣨",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "󰌽"
    },
    {
      "type": "wm",
      "key": "󰕮",
      "format": "{pretty-name} + Serpantinum"
    },
    {
      "type": "shell",
      "key": "󰆍"
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "memory",
      "key": "󰍛",
      "format": "{used} / {total}"
    },
    {
      "type": "battery",
      "key": "󰁹",
      "format": "{capacity} {status}"
    },
    {
      "type": "uptime",
      "key": "󰅐"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}